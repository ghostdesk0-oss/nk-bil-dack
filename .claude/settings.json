{
  "permissions": {
    "allow": ["Bash(npm run build)", "Bash(npm run check)", "Bash(npm run check -- --quick)", "Bash(npm test)", "Bash(npm run dev)"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.mjs" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.mjs" }] }
    ]
  }
}
